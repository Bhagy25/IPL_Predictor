  "verdicts": {
    "data": [
      {
        "assumption": "Chronological order, no leakage",
        "verdict": "Holds",
        "evidence": "9 folds per task: every training date precedes every evaluation date (smallest gap 150 days), 0 shared matches; 18,429 batter rows rebuilt from strictly earlier dates",
        "consequence": "Validation and test scores are not inflated by future information."
      },
      {
        "assumption": "Independent rows",
        "verdict": "Partially holds",
        "evidence": "36.2 wicket rows and 15.22 batter rows per match. Wicket: wicket by match ICC -0.00524 (p=1); wicket by innings ICC -0.00089 (p=0.71). Batter: 30+ by match ICC 0.00437 (p=0.059); 30+ by innings ICC 0.02207 (p=7.8e-08); 50+ by match ICC 0.0131 (p=3.3e-06); 50+ by innings ICC 0.03419 (p=7.9e-16)",
        "consequence": "Batter outcomes cluster slightly within an innings and a match, and wicket rows from one innings share its running score, so whole matches and seasons stay together in every split and uncertainty is reported across seasons, not rows."
      },
      {
        "assumption": "Stationary seasons",
        "verdict": "Violated",
        "evidence": "Largest season-vs-history shift: run_rate SMD 0.842 in 2026 (wicket), opposition_prior_innings SMD 0.588 in 2021 (batter); wicket rate 26.0%\u201328.9% by season",
        "consequence": "Older seasons describe a different scoring environment; expanding-window training and season-by-season evaluation measure the effect instead of assuming it away."
      },
      {
        "assumption": "Classes adequately represented",
        "verdict": "Partially holds",
        "evidence": "Wicket class shares {'0': 0.7218, '1': 0.2782}; batter {'0': 0.7448, '1': 0.1424, '2': 0.1129}; predicting the majority class scores 71.7% (wicket) and 72.9% (batter) accuracy",
        "consequence": "Accuracy is dominated by the majority class, so probability scores (Brier, log loss) rank the models."
      },
      {
        "assumption": "Complete inputs; sensible defaults",
        "verdict": "Partially holds",
        "evidence": "0 missing model inputs; 736 batter rows with no earlier innings use defaults (34 in 2026)",
        "consequence": "A debutant's 0.0 history rates are a code for 'no history', not an observed zero; prior_innings = 0 lets trees separate the two."
      },
      {
        "assumption": "Category levels seen in training",
        "verdict": "Partially holds",
        "evidence": "Rows with a level unseen in training: 2021: 253, 2022: 1620, 2023: 455, 2024: 279",
        "consequence": "Unseen levels (the two 2022 franchises, new venues) are encoded as all-zero, so those rows fall back on the other inputs."
      },
      {
        "assumption": "Measurement scales respected",
        "verdict": "Holds",
        "evidence": "Counts and rates are ratio-scale numbers; teams and venues are nominal (one-hot); phase is ordinal, one-hot encoded",
        "consequence": "No arithmetic is done on nominal codes."
      },
      {
        "assumption": "Eligibility rules applied",
        "verdict": "Holds",
        "evidence": "Wicket: 44,161 rows after removing D/L matches and censored overs; batter: 18,429 innings after removing D/L and no-result matches; super-over innings never enter",
        "consequence": "The forecasts describe ordinary, uninterrupted innings, not D/L-shortened ones."
      }
    ],
