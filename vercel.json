{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/raw/**,data/processed/**,data/derived/**,models/**,reports/**,reports/*.pdf,notebooks/**,docs/**,tests/**,scripts/**,web/**,web/node_modules/**,src/*.egg-info/**,*.md,pyproject.toml}",
      "includeFiles": "{data/processed/{matches,deliveries,innings,batter_innings,stage03_wicket_full_history_2008_2026}.csv,data/derived/*.csv,models/*_deployment_*.joblib,reports/{figures/stage_02/*.png,stage_01/*,stage_02/session_0[12]/*,stage_03/session_03/**}}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/)(?!.*\\.[A-Za-z0-9]+$).*)", "destination": "/index.html" }
  ]
}
