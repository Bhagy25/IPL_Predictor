{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{data/raw/**,data/processed/**,data/derived/**,models/**,reports/**,reports/*.pdf,notebooks/**,docs/**,tests/**,scripts/**,web/**,web/node_modules/**,src/*.egg-info/**,*.md,pyproject.toml}",
      "includeFiles": "{data/processed/matches.csv,data/processed/deliveries.csv,data/processed/innings.csv,data/processed/batter_innings.csv,data/processed/stage03_wicket_full_history_2008_2026.csv,data/derived/dismissals.csv,data/derived/non_boundary_events.csv,data/derived/batting_appearances.csv,data/derived/match_players.csv,data/derived/match_replacements.csv,data/derived/people.csv,models/wicket_deployment_through_2026.joblib,models/batter_deployment_through_2026.joblib,reports/figures/stage_02/*.png,reports/stage_01/audit_summary.json,reports/stage_01/missingness.csv,reports/stage_01/raw_over_anomalies.csv,reports/stage_02/session_01/season_first_innings_trends.csv,reports/stage_02/session_01/innings_phase_patterns_2018_2025.csv,reports/stage_02/session_01/first_innings_pearson_corr_2018_2025.csv,reports/stage_02/session_01/first_innings_spearman_corr_2018_2025.csv,reports/stage_02/session_01/venues_min20_first_innings_2018_2025.csv,reports/stage_02/session_01/match_field_missingness_pre2026.csv,reports/stage_02/session_02/toss_decision_match_result_crosstab_2018_2025.csv,reports/stage_03/session_03/stage03_session03_final_results.json,reports/stage_03/session_03/wicket/wicket_holdout_forecasts_2026.csv,reports/stage_03/session_03/batter/batter_holdout_forecasts_2026.csv}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/)(?!.*\\.[A-Za-z0-9]+$).*)", "destination": "/index.html" }
  ]
}
